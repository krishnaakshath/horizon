<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: hooks to exercise safe mode with adb (see DebugReceiver). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="dev.tvlauncher.debug.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.tvlauncher.debug.TRIP_SAFE_MODE" />
                <action android:name="dev.tvlauncher.debug.RESET_SAFE_MODE" />
                <action android:name="dev.tvlauncher.debug.CRASH_HOME" />
                <action android:name="dev.tvlauncher.debug.OPEN_SETTINGS" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: layout auditor (see dev.tvlauncher.audit.AuditReceiver). -->
        <receiver
            android:name="dev.tvlauncher.audit.AuditReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.tvlauncher.debug.AUDIT" />
                <action android:name="dev.tvlauncher.debug.AUDIT_DUMP_TREE" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: logs which apps publish Now Playing metadata and art (see NowPlayingProbeReceiver). -->
        <receiver
            android:name="dev.tvlauncher.debug.NowPlayingProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.tvlauncher.debug.NP_PROBE" />
            </intent-filter>
        </receiver>
        <provider
            android:name="dev.tvlauncher.audit.AuditInitProvider"
            android:authorities="${applicationId}.auditinit"
            android:exported="false"
            android:initOrder="1000" />
    </application>
</manifest>
