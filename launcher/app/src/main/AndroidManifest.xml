<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Optional: the owner's wallpaper collections in Pictures/TVLauncher and on USB sticks. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Boot signal: "Open home after power on" (power.PowerOnReceiver) and re-applying the automatic
         setup after a reboot (setup.SetupBootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Granted only by the owner (Settings > TV & system > Power & sleep > Power on opens the TV's page). On Android 10/11
         it lets the launcher bring home forward when the TV wakes; nothing is drawn over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <permission
        android:name="dev.tvlauncher.permission.POWER_ON_HOME"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.tvlauncher.permission.POWER_ON_HOME" />
    <!-- Spotlight's extra key is shared with the Launcher Helper over explicit broadcasts that
         only apps signed with our certificate can send or receive (spotlight/HelperLink.kt).
         The helper declares the same permission, so install order does not matter. -->
    <permission
        android:name="dev.tvlauncher.permission.SPOTLIGHT_SYNC"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.tvlauncher.permission.SPOTLIGHT_SYNC" />
    <!-- Settings > Volume & output reads and sets Launcher Helper's volume bar switch (same signer only). -->
    <permission
        android:name="dev.tvlauncher.permission.VOLUME_BAR"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.tvlauncher.permission.VOLUME_BAR" />
    <!-- Asks the weather companion to refresh when its data is stale (same signer only). Declared in
         both apps so install order does not matter. -->
    <permission
        android:name="dev.tvlauncher.permission.WEATHER_REFRESH"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.tvlauncher.permission.WEATHER_REFRESH" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- Settings > System > Controllers: the optional light buzz on a game controller's own motor. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Settings > Apps: uninstall a user app through the system's confirm dialog (required for
         ACTION_DELETE from targetSdk 28) and stop an app's background work. Settings > System >
         Speed uses the same normal permission to ask Android to close background apps (the
         system never closes anything in front, playing or persistent). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Optional, never requested: granted once by the one-time setup helper (tools/tvtool
         provision). With it setup switches on the notification listener and the Helper's
         accessibility service by itself, and the Accessibility page can switch captions,
         colour correction and the helper service. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lets the launcher ask its helper (same signer) to open the TV's power menu. -->
    <permission
        android:name="dev.tvlauncher.permission.HELPER_ACTIONS"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.tvlauncher.permission.HELPER_ACTIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Notification-access screen (Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS and the short spelling). -->
        <intent>
            <action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <!-- Optional companion apps: Spotlight shows a Browser quick action only when our
             browser is installed; the Settings screen detects the helper and browser. -->
        <!-- Setup probes for these screens before offering them; every system-screen button
             resolves its intent first (SystemActions.canStart), so each one is declared here. -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DEVICE_INFO_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DISPLAY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.INTERNAL_STORAGE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SOUND_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIRELESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.LOCATION_SOURCE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SYNC_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ADD_ACCOUNT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.LOCALE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.INPUT_METHOD_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_DEFAULT_APPS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.app.role.action.REQUEST_ROLE" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.USAGE_ACCESS_SETTINGS" />
        </intent>
        <package android:name="dev.tvlauncher.helper" />
        <package android:name="dev.tvlauncher.browser" />
        <!-- Get Apps companion store: listed on the Settings Add-ons page; Discover also
             hands F-Droid/GitHub apps to it. -->
        <package android:name="dev.tvlauncher.store" />
        <!-- Safe mode offers the stock launcher only while it is installed and enabled. -->
        <package android:name="com.google.android.tvlauncher" />
        <!-- Safe mode's last Settings fallback: the Android TV Settings app's launch intent. -->
        <package android:name="com.android.tv.settings" />
        <!-- Weather companion app (the launcher has no INTERNET permission). -->
        <package android:name="dev.tvlauncher.weather" />
        <provider android:authorities="dev.tvlauncher.weather" />
        <!-- Discover: Play Store detail pages (market://, then the https page in a browser)
             (the Get Apps companion is declared above). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.android.vending" />
        <!-- Accessibility page: the screen reader row shows only when one is installed. -->
        <package android:name="com.google.android.marvin.talkback" />
        <!-- System pages: live TV / guide (TCL TV app) and the "Managed by the TV" screens. -->
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.settings" />
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
        <!-- Settings > Private DNS: "Cloudflare WARP" opens Cloudflare's own app when installed. -->
        <package android:name="com.cloudflare.onedotonedotonedotone" />
    </queries>

    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:label="TV Launcher"
        android:theme="@style/HomeTheme">
        <activity
            android:name=".HomeActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Opens the Spotlight panel (e.g. from a key-mapping helper or adb am start). -->
            <intent-filter>
                <action android:name="dev.tvlauncher.action.SPOTLIGHT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Fallback after repeated crashes. Reached only through HomeActivity's redirect:
             deliberately not a HOME candidate. Own task (empty affinity) and a framework theme,
             so it shares nothing with the home task or the launcher's styles. -->
        <activity
            android:name=".safemode.SafeModeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity
            android:name=".insights.InsightsActivity"
            android:exported="false" />
        <activity
            android:name=".appsettings.AppSettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:configChanges="keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="dev.tvlauncher.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ambient.AmbientActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/AmbientTheme">
            <intent-filter>
                <action android:name="dev.tvlauncher.action.AMBIENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- First-run checklist (setup package); also Settings > System > Setup. -->
        <!-- Exported only for the Helper app's "Finish setup to enable" row; it shows the checklist. -->
        <activity
            android:name=".setup.SetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="dev.tvlauncher.action.SETUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".setup.SetupBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- System screensaver; select with `settings put secure screensaver_components`. -->
        <service
            android:name=".ambient.AmbientDream"
            android:exported="true"
            android:label="TV Launcher Ambient"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- "Open home after power on" (Settings > TV & system > Power & sleep > Power on): cold boot, and TCL's
             wake-from-standby broadcast (sent with FLAG_RECEIVER_INCLUDE_BACKGROUND).
             Nothing else is accepted; PowerOnPolicy acts at most once per wake. -->
        <receiver
            android:name=".power.PowerOnReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="tcl.sys.intent.action.STR_RESUME_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The Launcher Helper's state (service on, which Spotlight key it holds). Signature
             permission: only our own helper can send it. -->
        <receiver
            android:name=".spotlight.HelperStateReceiver"
            android:exported="true"
            android:permission="dev.tvlauncher.permission.SPOTLIGHT_SYNC">
            <intent-filter>
                <action android:name="dev.tvlauncher.action.HELPER_STATE" />
            </intent-filter>
        </receiver>

        <!-- Sleep timer: fires once at the chosen time (not exported). -->
        <receiver
            android:name=".system.SleepTimerReceiver"
            android:exported="false" />

        <!-- Controller settings (A/B swap, stick sensitivity, Guide button) for the companion apps
             and the Helper. Read-only; nothing private in it. -->
        <provider
            android:name=".controllers.GamepadSettingsProvider"
            android:authorities="dev.tvlauncher.gamepad"
            android:exported="true" />

        <!-- Opt-in notification chips; bound only by the system after the user grants access. -->
        <service
            android:name=".ambient.AmbientNotificationService"
            android:exported="true"
            android:label="TV Launcher ambient notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Settings > System > Speed: the quiet-hour alarm (own PendingIntent only), re-arming it
             after boot or an update, and the system's idle job. Each only checks SpeedPrefs and
             AutoPolicy; none can be started by other apps. -->
        <receiver
            android:name=".speed.SpeedAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".speed.SpeedBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".speed.SpeedJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
