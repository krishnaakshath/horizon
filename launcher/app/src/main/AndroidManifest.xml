<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Optional: the owner's wallpaper collections in Pictures/TVLauncher and on USB sticks. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Settings > Apps: uninstall a user app through the system's confirm dialog (required for
         ACTION_DELETE from targetSdk 28) and stop an app's background work. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Optional, never requested: granted once by the owner's provisioning tool. With it the
         Accessibility page can switch captions, colour correction and the helper service itself. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lets the launcher ask its helper (same signer) to open the TV's power menu. -->
    <permission
        android:name="dev.tvlauncher.permission.HELPER_ACTIONS"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.tvlauncher.permission.HELPER_ACTIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Notification-access screen (Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS and the short spelling). -->
        <intent>
            <action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <!-- Optional companion apps: Spotlight shows a Browser quick action only when our
             browser is installed; the Settings screen detects the helper and browser. -->
        <package android:name="dev.tvlauncher.helper" />
        <package android:name="dev.tvlauncher.browser" />
        <!-- Get Apps companion store: listed on the Settings Add-ons page; Discover also
             hands F-Droid/GitHub apps to it. -->
        <package android:name="dev.tvlauncher.store" />
        <!-- Safe mode offers the stock launcher only while it is installed and enabled. -->
        <package android:name="com.google.android.tvlauncher" />
        <!-- Safe mode's last Settings fallback: the Android TV Settings app's launch intent. -->
        <package android:name="com.android.tv.settings" />
        <!-- Weather companion app (the launcher has no INTERNET permission). -->
        <package android:name="dev.tvlauncher.weather" />
        <provider android:authorities="dev.tvlauncher.weather" />
        <!-- Discover: Play Store detail pages (market://, then the https page in a browser)
             (the Get Apps companion is declared above). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.android.vending" />
        <!-- Accessibility page: the screen reader row shows only when one is installed. -->
        <package android:name="com.google.android.marvin.talkback" />
        <!-- System pages: live TV / guide (TCL TV app) and the "Managed by the TV" screens. -->
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.settings" />
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:label="TV Launcher"
        android:theme="@style/HomeTheme">
        <activity
            android:name=".HomeActivity"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Opens the Spotlight panel (e.g. from a key-mapping helper or adb am start). -->
            <intent-filter>
                <action android:name="dev.tvlauncher.action.SPOTLIGHT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Fallback after repeated crashes. Reached only through HomeActivity's redirect:
             deliberately not a HOME candidate. Own task (empty affinity) and a framework theme,
             so it shares nothing with the home task or the launcher's styles. -->
        <activity
            android:name=".safemode.SafeModeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity
            android:name=".insights.InsightsActivity"
            android:exported="false" />
        <activity
            android:name=".appsettings.AppSettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:configChanges="keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="dev.tvlauncher.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ambient.AmbientActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/AmbientTheme">
            <intent-filter>
                <action android:name="dev.tvlauncher.action.AMBIENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- System screensaver; select with `settings put secure screensaver_components`. -->
        <service
            android:name=".ambient.AmbientDream"
            android:exported="true"
            android:label="TV Launcher Ambient"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Sleep timer: fires once at the chosen time (not exported). -->
        <receiver
            android:name=".system.SleepTimerReceiver"
            android:exported="false" />

        <!-- Opt-in notification chips; bound only by the system after the user grants access. -->
        <service
            android:name=".ambient.AmbientNotificationService"
            android:exported="true"
            android:label="TV Launcher ambient notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
