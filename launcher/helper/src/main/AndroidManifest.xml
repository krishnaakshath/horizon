<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Same signer as the launcher only: its "Open home after power on" request. Declared in both
         apps so the install order does not matter. -->
    <permission
        android:name="dev.tvlauncher.permission.POWER_ON_HOME"
        android:protectionLevel="signature" />
    <!-- Same signer only: the launcher's Settings > Volume & output reads and sets the volume bar switch. -->
    <permission
        android:name="dev.tvlauncher.permission.VOLUME_BAR"
        android:protectionLevel="signature" />

    <!-- Granted only by the one-time setup helper; lets this app switch its own service on
         on TVs without an accessibility screen. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <!-- Shared with the launcher (same certificate only): carries Spotlight's extra key.
         See SpotlightSync.kt. Declared in both apps so install order does not matter. -->
    <permission
        android:name="dev.tvlauncher.permission.SPOTLIGHT_SYNC"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.tvlauncher.permission.SPOTLIGHT_SYNC" />

    <!-- Package visibility (API 30+): the Spotlight intent and the state broadcast go to the launcher. -->
    <queries>
        <!-- The launcher's "Guide button opens Home" choice, read-only. -->
        <provider android:authorities="dev.tvlauncher.gamepad" />
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="dev.tvlauncher.action.SETUP" />
        </intent>
        <package android:name="dev.tvlauncher" />
    </queries>

    <!-- Same definition as in the launcher (same signer): only the launcher may ask for the power menu. -->
    <permission
        android:name="dev.tvlauncher.permission.HELPER_ACTIONS"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".HelperSettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HelperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Runs the launcher's request through the accessibility service (HOME, like the remote). -->
        <receiver
            android:name=".PowerOnHomeReceiver"
            android:exported="true"
            android:permission="dev.tvlauncher.permission.POWER_ON_HOME">
            <intent-filter>
                <action android:name="dev.tvlauncher.helper.action.HOME_AFTER_POWER_ON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SpotlightSyncReceiver"
            android:exported="true"
            android:permission="dev.tvlauncher.permission.SPOTLIGHT_SYNC">
            <intent-filter>
                <action android:name="dev.tvlauncher.helper.action.SPOTLIGHT_SYNC" />
            </intent-filter>
        </receiver>

        <!-- Volume bar switch and status for the launcher (volume/VolumeBarReceiver). -->
        <receiver
            android:name=".volume.VolumeBarReceiver"
            android:exported="true"
            android:permission="dev.tvlauncher.permission.VOLUME_BAR">
            <intent-filter>
                <action android:name="dev.tvlauncher.helper.action.VOLUME_BAR" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
