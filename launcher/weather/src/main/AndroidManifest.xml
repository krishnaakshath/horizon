<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The launcher asks for a refresh when its copy is stale (same signer only). Declared in
         both apps so install order does not matter. -->
    <permission
        android:name="dev.tvlauncher.permission.WEATHER_REFRESH"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.tvlauncher.permission.WEATHER_REFRESH" />

    <!-- The launcher's controller settings (A/B swap, stick sensitivity), read-only. -->
    <queries>
        <provider android:authorities="dev.tvlauncher.gamepad" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner_weather"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".WeatherApp"
        android:theme="@style/WeatherTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".WeatherSettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="dev.tvlauncher.weather.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Exported on purpose: the launcher (a different app) reads current weather and a
            5-day forecast. It is read-only (insert/update/delete throw) and exposes only
            non-sensitive data: a city name the user picked and public forecast values.
        -->
        <provider
            android:name=".WeatherProvider"
            android:authorities="dev.tvlauncher.weather"
            android:exported="true" />

        <!-- Public refresh trigger; rate limited to once per 2 minutes inside the receiver. -->
        <receiver
            android:name=".RefreshReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.tvlauncher.weather.action.REFRESH" />
            </intent-filter>
        </receiver>

        <!-- Launcher only: the sender must hold the signature permission. Does nothing unless the data is stale. -->
        <receiver
            android:name=".TriggerReceiver"
            android:exported="true"
            android:permission="dev.tvlauncher.permission.WEATHER_REFRESH">
            <intent-filter>
                <action android:name="dev.tvlauncher.weather.action.REFRESH_IF_STALE" />
            </intent-filter>
        </receiver>

        <!--
            The TV's wake-from-standby broadcast. Exported because the sender is a TV system app
            that is not necessarily the system user; it carries no data, takes no input, and the
            receiver only runs the staleness and rate rules.
        -->
        <receiver
            android:name=".WakeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="tcl.sys.intent.action.STR_RESUME_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Only the system sends BOOT_COMPLETED / MY_PACKAGE_REPLACED, so this stays unexported. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Bound by the system job scheduler only. -->
        <service
            android:name=".RefreshJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
