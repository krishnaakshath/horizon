{
  "description": "Opens Settings on Home layout (debug OPEN_SETTINGS, never a remembered page) > Home sections: the Everything preset. Audit the settings page and its preview, the stacked home, UP/DOWN between sections keeping the column and a page jump; then back to Classic.",
  "package": "dev.tvlauncher",
  "restart": false,
  "start": {
    "action": "android.intent.action.MAIN",
    "category": "android.intent.category.LEANBACK_LAUNCHER"
  },
  "steps": [
    {
      "wait": 2
    },
    {
      "settings": "home_layout",
      "wait": 1,
      "note": "HOME, then Settings opened on Home layout (debug OPEN_SETTINGS): a known page"
    },
    {
      "key": "DPAD_RIGHT",
      "wait": 1,
      "note": "into the page: the Layout style row"
    },
    {
      "key": "DPAD_DOWN",
      "wait": 1,
      "note": "Home sections"
    },
    {
      "key": "DPAD_CENTER",
      "wait": 2,
      "note": "opens Home sections; focus on Preset"
    },
    {
      "key": "DPAD_LEFT",
      "repeat": 5,
      "wait": 1,
      "note": "Preset stops at Classic"
    },
    {
      "key": "DPAD_RIGHT",
      "repeat": 3,
      "wait": 1.5,
      "note": "the Everything preset; the preview follows"
    },
    {
      "audit": "home-everything-settings"
    },
    {
      "screenshot": "home-everything-settings"
    },
    {
      "key": "DPAD_DOWN",
      "wait": 1,
      "note": "Sections"
    },
    {
      "key": "DPAD_CENTER",
      "wait": 2,
      "note": "the list of sections"
    },
    {
      "audit": "home-everything-list"
    },
    {
      "key": "BACK",
      "wait": 1.5
    },
    {
      "key": "HOME",
      "wait": 4,
      "note": "home rebuilds its section rows"
    },
    {
      "audit": "home-everything-start"
    },
    {
      "screenshot": "home-everything-start"
    },
    {
      "key": "DPAD_UP",
      "wait": 1.5,
      "note": "the section above Apps, same column"
    },
    {
      "audit": "home-everything-up"
    },
    {
      "key": "DPAD_RIGHT",
      "repeat": 3,
      "wait": 1.5
    },
    {
      "key": "DPAD_DOWN",
      "wait": 1.5,
      "note": "back to Apps at the nearest column"
    },
    {
      "audit": "home-everything-down"
    },
    {
      "key": "PAGE_DOWN",
      "wait": 1.5,
      "note": "L1/R1 page jump on the Apps shelf"
    },
    {
      "audit": "home-everything-page"
    },
    {
      "settings": "home_layout",
      "wait": 1,
      "note": "HOME, then Settings opened on Home layout (debug OPEN_SETTINGS): a known page"
    },
    {
      "key": "DPAD_RIGHT",
      "wait": 1,
      "note": "into the page: the Layout style row"
    },
    {
      "key": "DPAD_DOWN",
      "wait": 1,
      "note": "Home sections"
    },
    {
      "key": "DPAD_CENTER",
      "wait": 2,
      "note": "opens Home sections; focus on Preset"
    },
    {
      "key": "DPAD_LEFT",
      "repeat": 5,
      "wait": 1,
      "note": "Preset stops at Classic"
    },
    {
      "key": "HOME",
      "wait": 4,
      "note": "back on Classic: the single row"
    },
    {
      "audit": "home-everything-classic"
    }
  ]
}
