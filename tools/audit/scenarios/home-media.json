{
  "description": "Settings > Home layout > Home sections: the Media preset. Audit the settings page and its preview, the stacked home, UP/DOWN between sections keeping the column and a page jump; then back to Classic.",
  "package": "dev.tvlauncher",
  "restart": false,
  "start": {
    "action": "android.intent.action.MAIN",
    "category": "android.intent.category.LEANBACK_LAUNCHER"
  },
  "steps": [
    {
      "wait": 2
    },
    {
      "key": "DPAD_UP",
      "repeat": 6,
      "wait": 1,
      "note": "from any section row up into the top bar"
    },
    {
      "key": "DPAD_RIGHT",
      "repeat": 6,
      "wait": 1,
      "note": "clamps on the rightmost pill (Settings)"
    },
    {
      "key": "DPAD_CENTER",
      "wait": 3,
      "note": "Settings opens on Home > Appearance"
    },
    {
      "key": "DPAD_UP",
      "repeat": 10,
      "wait": 1,
      "note": "top of the sidebar: the Home group header"
    },
    {
      "key": "DPAD_DOWN",
      "repeat": 2,
      "wait": 1.5,
      "note": "Appearance, then Home layout"
    },
    {
      "key": "DPAD_RIGHT",
      "wait": 1,
      "note": "into the page: the Layout style row"
    },
    {
      "key": "DPAD_DOWN",
      "wait": 1,
      "note": "Home sections"
    },
    {
      "key": "DPAD_CENTER",
      "wait": 2,
      "note": "opens Home sections; focus on Preset"
    },
    {
      "key": "DPAD_LEFT",
      "repeat": 5,
      "wait": 1,
      "note": "Preset stops at Classic"
    },
    {
      "key": "DPAD_RIGHT",
      "repeat": 2,
      "wait": 1.5,
      "note": "the Media preset; the preview follows"
    },
    {
      "audit": "home-media-settings"
    },
    {
      "screenshot": "home-media-settings"
    },
    {
      "key": "DPAD_DOWN",
      "wait": 1,
      "note": "Sections"
    },
    {
      "key": "DPAD_CENTER",
      "wait": 2,
      "note": "the list of sections"
    },
    {
      "audit": "home-media-list"
    },
    {
      "key": "BACK",
      "wait": 1.5
    },
    {
      "key": "HOME",
      "wait": 4,
      "note": "home rebuilds its section rows"
    },
    {
      "audit": "home-media-start"
    },
    {
      "screenshot": "home-media-start"
    },
    {
      "key": "DPAD_UP",
      "wait": 1.5,
      "note": "the section above Apps, same column"
    },
    {
      "audit": "home-media-up"
    },
    {
      "key": "DPAD_RIGHT",
      "repeat": 3,
      "wait": 1.5
    },
    {
      "key": "DPAD_DOWN",
      "wait": 1.5,
      "note": "back to Apps at the nearest column"
    },
    {
      "audit": "home-media-down"
    },
    {
      "key": "PAGE_DOWN",
      "wait": 1.5,
      "note": "L1/R1 page jump on the Apps shelf"
    },
    {
      "audit": "home-media-page"
    },
    {
      "key": "DPAD_UP",
      "repeat": 6,
      "wait": 1,
      "note": "from any section row up into the top bar"
    },
    {
      "key": "DPAD_RIGHT",
      "repeat": 6,
      "wait": 1,
      "note": "clamps on the rightmost pill (Settings)"
    },
    {
      "key": "DPAD_CENTER",
      "wait": 3,
      "note": "Settings opens on Home > Appearance"
    },
    {
      "key": "DPAD_UP",
      "repeat": 10,
      "wait": 1,
      "note": "top of the sidebar: the Home group header"
    },
    {
      "key": "DPAD_DOWN",
      "repeat": 2,
      "wait": 1.5,
      "note": "Appearance, then Home layout"
    },
    {
      "key": "DPAD_RIGHT",
      "wait": 1,
      "note": "into the page: the Layout style row"
    },
    {
      "key": "DPAD_DOWN",
      "wait": 1,
      "note": "Home sections"
    },
    {
      "key": "DPAD_CENTER",
      "wait": 2,
      "note": "opens Home sections; focus on Preset"
    },
    {
      "key": "DPAD_LEFT",
      "repeat": 5,
      "wait": 1,
      "note": "Preset stops at Classic"
    },
    {
      "key": "HOME",
      "wait": 4,
      "note": "back on Classic: the single row"
    },
    {
      "audit": "home-media-classic"
    }
  ]
}
