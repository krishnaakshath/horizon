{
  "description": "Opens Settings on Home layout (debug OPEN_SETTINGS, never a remembered page), sets Style to Two rows, audits the home screen, then sets Single row again.",
  "package": "dev.tvlauncher",
  "restart": false,
  "start": {
    "action": "android.intent.action.MAIN",
    "category": "android.intent.category.LEANBACK_LAUNCHER"
  },
  "steps": [
    {
      "wait": 2
    },
    {
      "settings": "home_layout",
      "wait": 1,
      "note": "HOME, then Settings opened on Home layout (debug OPEN_SETTINGS): a known page"
    },
    {
      "key": "DPAD_RIGHT",
      "wait": 1,
      "note": "into the page: focus on the first row, Layout style"
    },
    {
      "key": "DPAD_CENTER",
      "wait": 2,
      "note": "opens Layout style; focus on its first row, Style"
    },
    {
      "audit": "home-two-rows-settings"
    },
    {
      "screenshot": "home-two-rows-settings"
    },
    {
      "key": "DPAD_LEFT",
      "repeat": 4,
      "wait": 1,
      "note": "Style stops at Single row"
    },
    {
      "key": "DPAD_RIGHT",
      "repeat": 1,
      "wait": 1.5,
      "note": "the style under test; the preview follows"
    },
    {
      "audit": "home-two-rows-preview"
    },
    {
      "key": "HOME",
      "wait": 4,
      "note": "home relays itself out (200 ms fade)"
    },
    {
      "audit": "home-two-rows-start"
    },
    {
      "screenshot": "home-two-rows-start"
    },
    {
      "key": "DPAD_DOWN",
      "wait": 1.5
    },
    {
      "audit": "home-two-rows-bottom"
    },
    {
      "key": "DPAD_RIGHT",
      "repeat": 4,
      "wait": 1.5
    },
    {
      "audit": "home-two-rows-scrolled"
    },
    {
      "key": "PAGE_DOWN",
      "wait": 1.5
    },
    {
      "audit": "home-two-rows-page"
    },
    {
      "wait": 2,
      "note": "dwell so the quick strip appears under the bottom row"
    },
    {
      "audit": "home-two-rows-strip"
    },
    {
      "screenshot": "home-two-rows-strip"
    },
    {
      "key": "DPAD_UP",
      "wait": 1.5
    },
    {
      "audit": "home-two-rows-top"
    },
    {
      "settings": "home_layout",
      "wait": 1,
      "note": "HOME, then Settings opened on Home layout (debug OPEN_SETTINGS): a known page"
    },
    {
      "key": "DPAD_RIGHT",
      "wait": 1,
      "note": "into the page: focus on the first row, Layout style"
    },
    {
      "key": "DPAD_CENTER",
      "wait": 2,
      "note": "opens Layout style; focus on its first row, Style"
    },
    {
      "key": "DPAD_LEFT",
      "repeat": 4,
      "wait": 1,
      "note": "restore: Style back to Single row (the default)"
    },
    {
      "key": "HOME",
      "wait": 4,
      "note": "home relays itself out as Single row"
    }
  ]
}
