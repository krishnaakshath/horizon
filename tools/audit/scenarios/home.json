{
  "description": "Cold start, walk the shelf, quick strip, Spotlight and its quick actions.",
  "package": "dev.tvlauncher",
  "restart": true,
  "start": {"action": "android.intent.action.MAIN", "category": "android.intent.category.LEANBACK_LAUNCHER"},
  "steps": [
    {"wait": 4, "note": "splash + reveal settle"},
    {"audit": "home-start"},
    {"screenshot": "home-start"},
    {"key": "DPAD_RIGHT", "repeat": 2, "wait": 1.5},
    {"audit": "home-tile-3"},
    {"key": "DPAD_RIGHT", "repeat": 2, "wait": 1.5},
    {"audit": "home-tile-5"},
    {"screenshot": "home-tile-5"},
    {"key": "DPAD_RIGHT", "repeat": 2, "wait": 1.5},
    {"audit": "home-tile-7"},
    {"wait": 2, "note": "dwell so the quick strip appears"},
    {"audit": "home-quickstrip"},
    {"screenshot": "home-quickstrip"},
    {"key": "DPAD_DOWN", "wait": 1.5},
    {"audit": "home-quickstrip-focus"},
    {"key": "BACK", "wait": 1.5},
    {"key": "MENU", "wait": 2},
    {"audit": "spotlight-open"},
    {"screenshot": "spotlight-open"},
    {"key": "DPAD_DOWN", "wait": 1},
    {"audit": "spotlight-quick-actions"},
    {"key": "DPAD_DOWN", "wait": 1},
    {"audit": "spotlight-results"},
    {"key": "BACK", "wait": 1.5},
    {"audit": "home-after-back"}
  ]
}
